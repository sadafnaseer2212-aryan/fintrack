# FinTrack configuration example. Copy the values you need into your environment
# (or your hosting platform's settings). Never commit real secrets.
# Running locally needs NONE of these: sensible defaults are built in.

# REQUIRED in production: a long random string, e.g. from
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# SQLite database file. Default when running locally: instance/finance.db
# (Docker uses /app/data/finance.db on a volume)
DATABASE_PATH=

# Local server address and port for "python app.py" (defaults 127.0.0.1 and 5000)
HOST=127.0.0.1
PORT=5000

# Local development only: 1 = auto-reload + debugger. Never enable in production.
FLASK_DEBUG=0

# Set to 1 when the site is served over HTTPS (Render sets this in render.yaml)
SESSION_COOKIE_SECURE=0

# PostgreSQL connection string (Neon on Vercel). If empty, SQLite (DATABASE_PATH) is used.
DATABASE_URL=
